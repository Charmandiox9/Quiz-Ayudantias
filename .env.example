# Configuracion de Supabase (Credenciales de conexion)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anonima_publica
VITE_APP_URL=http://localhost:5173

# En Vercel, configura VITE_APP_URL con la URL pública de producción y vuelve a desplegar.
# En Supabase Auth, agrega la URL local y la de producción a Redirect URLs.
# Nunca pongas la service_role key en variables VITE_* ni en el navegador.
