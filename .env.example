# Configuracion de Supabase (Credenciales de conexion)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anonima_publica
VITE_APP_URL=http://localhost:5173

# Cloudflare R2 (solo servidor; no usar prefijo VITE_ para credenciales)
R2_ACCOUNT_ID=tu_account_id
R2_ACCESS_KEY_ID=tu_access_key_id
R2_SECRET_ACCESS_KEY=tu_secret_access_key
R2_BUCKET_NAME=quiz-ayudantias-images
R2_PUBLIC_BASE_URL=https://images.tudominio.cl

# En Vercel, duplica las variables públicas de Supabase para que las use la función API.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_clave_anonima_publica

# En Vercel, configura VITE_APP_URL con la URL pública de producción y vuelve a desplegar.
# En Supabase Auth, agrega la URL local y la de producción a Redirect URLs.
# Nunca pongas la service_role key en variables VITE_* ni en el navegador.
